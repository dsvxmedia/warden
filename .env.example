# Copy this file to .env and fill in values. .env is gitignored — never
# commit real secrets or environment-specific values.

# Base image used for sandboxed execution. Keep this minimal.
WARDEN_SANDBOX_IMAGE=alpine:3.20

# Resource limits applied to every sandbox container.
WARDEN_MEMORY_LIMIT=256m
WARDEN_CPU_LIMIT=0.5
WARDEN_PIDS_LIMIT=64

# Hard wall-clock timeout for a single sandboxed execution, in ms.
WARDEN_TIMEOUT_MS=15000
